# Copy this file to .env and adjust values as needed.

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:4200

# Supabase project credentials (Project Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "service_role" / secret key here, NOT the "anon"/publishable key.
# This key is secret — never commit it, never put it in frontend code.
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: protects GET /api/enquiries (the admin listing endpoint).
# Leave blank while developing locally; set a real value before deploying.
ADMIN_KEY=

# Optional: email alert when a new enquiry is submitted.
# Leave all four blank to disable email alerts (enquiries still save normally).
# Example using Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=youraddress@gmail.com, SMTP_PASS=<16-char App Password, not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where enquiry alert emails should be sent (can be same as SMTP_USER).
ALERT_EMAIL_TO=
