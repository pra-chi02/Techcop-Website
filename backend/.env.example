# Copy this file to .env and adjust values as needed.

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:4200

# Supabase project credentials (Project Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "service_role" key here, NOT the "anon" key.
# This key is secret — never commit it, never put it in frontend code.
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: protects GET /api/enquiries (the admin listing endpoint).
# Leave blank while developing locally; set a real value before deploying.
ADMIN_KEY=
